BEGIN;
PROCEDURE RUN;
    VARIABLE X 1;
    VARIABLE S 80;
    VARIABLE B 1;
    X := 42;
    S := 'hello';
    B := LO(1);
    WRITE 6 X;
    WRITE 6 S;
    WRITE 6 B;
ENDPROCEDURE;
