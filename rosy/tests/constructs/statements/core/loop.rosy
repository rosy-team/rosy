======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE I 1;
    VARIABLE SUM 1;
    SUM := 0;
    LOOP I 1 5;
        SUM := SUM + I;
    ENDLOOP;
    WRITE 6 SUM;
ENDPROCEDURE;
RUN;
END;
