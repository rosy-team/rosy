BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE INPUT 2000;
    VARIABLE OUTPUT 2000;
    DAINI 3 2 0 NM;
    INPUT := DA(1);
    DAPLU INPUT 1 2.0 OUTPUT;
    WRITE 6 'daplu ok';
ENDPROCEDURE;
RUN;
END;
