BEGIN;
    VARIABLE (DA 2) f;
    VARIABLE (DA 1) g;
    VARIABLE (DA 1) result;
    DAINI 3 2 0 0;
    f(1) := DA(2);
    f(2) := DA(1);
    g(1) := DA(1)*DA(1) + DA(2)*DA(2);
    DAGMD g f result 2;
    DAPRV result 1 2 2 6;
    WRITE 6 'dagmd ok';
END;

