======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE W 1 2;
    VARIABLE RES 2000 1;

    W(1) := 1; W(2) := 2;
    DANOTW W 2;
    DAINI 4 2 0 0;

    RES(1) := DA(1) + DA(2) + DA(1)*DA(1) + DA(1)*DA(2) + DA(2)*DA(2);
    DAPRV RES 1 2 2 6;
ENDPROCEDURE;
RUN;
END;
