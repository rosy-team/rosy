BEGIN;
    VARIABLE (VE) W;
    VARIABLE (DA 1) RES;

    { Test: Weighted DA with weights (1,2), order 4, 2 vars }
    W := 1&2;
    DANOTW W 2;
    DAINI 4 2 0 0;

    RES(1) := DA(1) + DA(2) + DA(1)*DA(1) + DA(1)*DA(2) + DA(2)*DA(2);
    DAPRV RES 1 2 2 6;
END;

