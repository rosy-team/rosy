BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) A;
    VARIABLE (RE) R;
    VARIABLE (RE 2) EXPS;
    EXPS(1) := 1;
    EXPS(2) := 0;
    A(1) := 3*DA(1) + 5*DA(2);
    DAPEA A EXPS 2 R;
    WRITE 6 R;
    WRITE 6 'dapea ok';
END;

