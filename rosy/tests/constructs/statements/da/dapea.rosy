BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE A 2000;
    VARIABLE R 1;
    VARIABLE EXPS 1 2;
    DAINI 3 2 0 NM;
    EXPS(1) := 1;
    EXPS(2) := 0;
    A := 3*DA(1) + 5*DA(2);
    DAPEA A EXPS 2 R;
    WRITE 6 R;
    WRITE 6 'dapea ok';
ENDPROCEDURE;
RUN;
END;
