BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE INPUT 2000;
    VARIABLE LINEAR 1 2;
    DAINI 3 2 0 NM;
    INPUT := DA(1) + 2*DA(2);
    DACLIW INPUT 2 LINEAR;
    WRITE 6 LINEAR(1);
    WRITE 6 LINEAR(2);
    WRITE 6 'dacliw ok';
ENDPROCEDURE;
RUN;
END;
