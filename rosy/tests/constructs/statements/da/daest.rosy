BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) A;
    VARIABLE (RE) R;
    A(1) := DA(1) + 2*DA(1)*DA(2) + 3*DA(2)*DA(2);
    DAEST A 0 2 R;
    WRITE 6 R;
    WRITE 6 'daest ok';
END;

