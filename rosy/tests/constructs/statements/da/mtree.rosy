BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 2) MAP;
    MAP(1) := DA(1) + 0.1 * DA(2);
    MAP(2) := DA(2) + 0.1 * DA(1);
    VARIABLE (RE 100) COEFF;
    VARIABLE (RE 100) STEER1;
    VARIABLE (RE 100) STEER2;
    VARIABLE (RE) ELEM2;
    VARIABLE (RE) TLEN;
    MTREE MAP 2 COEFF STEER1 STEER2 ELEM2 TLEN;
    WRITE 6 'mtree ok';
END;

======= expect
mtree ok

======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE MAP 2000 1;
    VARIABLE ELEM1 1;
    VARIABLE COEFF 1 100;
    VARIABLE STEER1 1 100;
    VARIABLE STEER2 1 100;
    VARIABLE ELEM2 1;
    VARIABLE TLEN 1;
    DAINI 3 2 0 NM;
    MAP(1) := DA(1) + 0.1*DA(2);
    ELEM1 := 1;
    MTREE MAP ELEM1 COEFF STEER1 STEER2 ELEM2 TLEN;
    WRITE 6 TLEN;
    WRITE 6 'mtree ok';
ENDPROCEDURE;
RUN;
END;
