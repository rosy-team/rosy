BEGIN;
    { fox CDNFDA dest is a mem cell; input may still be DA }
    VARIABLE (DA) A;
    VARIABLE (CD) T;
    VARIABLE (VE) moduli;
    VARIABLE (VE) args;
    DAINI 3 4 0 0;
    A := DA(2);
    moduli := 1&1&1&1;
    args := 0.1&0.2&0.3&0.4;
    CDNFDA A moduli args 1 4 0.001 T;
    WRITE 6 REAL(T);
END;

