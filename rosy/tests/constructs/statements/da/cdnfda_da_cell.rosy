======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE A 2000;
    VARIABLE T 2000;
    VARIABLE R 1 4;
    VARIABLE PHI 1 4;
    VARIABLE I 1;
    DAINI 3 4 0 NM;
    A := DA(2);
    LOOP I 1 4;
        R(I) := 1;
        PHI(I) := 0.1 * I;
    ENDLOOP;
    CDNFDA A R PHI 1 4 0.001 T;
    WRITE 6 REAL(T);
ENDPROCEDURE;
RUN;
END;
