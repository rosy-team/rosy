BEGIN;
    { 1D exponential: z' = z, ic = CD(1) }
    { Flow: z(1) = e * x1, coefficient of x1 = e ≈ 2.71828 }
    VARIABLE (CD 1) rhs;
    VARIABLE (CD 1) ic;
    VARIABLE (CD 1) result;
    VARIABLE (DA 1) real_part;
    DAINI 3 1 0 0;
    rhs(1) := CD(1);
    ic(1) := CD(1);
    CDFLO rhs ic result 1;
    real_part(1) := REAL(result(1));
    DAPRV real_part 1 1 1 6;
    WRITE 6 'cdflo ok';
END;

======= expect
   2.718281828459     1
 ------------------------------------------------------------------------------
cdflo ok

======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE rhs 2000 1;
    VARIABLE ic 2000;
    VARIABLE result 2000;
    DAINI 3 1 0 NM;
    rhs(1) := DA(1);
    ic := DA(1);
    DAFLO rhs ic result 1;
    WRITE 6 result;
    WRITE 6 'cdflo ok';
ENDPROCEDURE;
RUN;
END;
