BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE X 2000;
    VARIABLE NORMS 1 10;
    VARIABLE MAXPOW 1;
    DAINI 3 2 0 NM;
    X := 1 + DA(1) + DA(1)*DA(1);
    DANORO X 0 10 NORMS MAXPOW;
    WRITE 6 MAXPOW;
    WRITE 6 'danoro ok';
ENDPROCEDURE;
RUN;
END;
