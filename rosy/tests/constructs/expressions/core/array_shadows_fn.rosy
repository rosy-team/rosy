======= fox
BEGIN ;
PROCEDURE RUN ;
    FUNCTION MA A B ;
        MA := 0 ;
    ENDFUNCTION ;
    VARIABLE MA 1 2 2 ;
    MA(1, 2) := 3 ;
    WRITE 6 MA(1, 2) ;
ENDPROCEDURE ;
RUN ;
END ;
