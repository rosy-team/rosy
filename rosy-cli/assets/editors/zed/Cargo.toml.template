[workspace]

[package]
name = "zed-rosy"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
path = "src/lib.rs"
crate-type = ["cdylib"]

[dependencies]
zed_extension_api = "0.7"

# Incremental compilation uses file locks that fail on WSL UNC paths
# (\\wsl.localhost\...) when Windows Zed builds a Linux-side checkout.
[profile.dev]
incremental = false

[profile.release]
incremental = false
