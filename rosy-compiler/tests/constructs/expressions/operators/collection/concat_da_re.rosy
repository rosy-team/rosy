BEGIN;
PROCEDURE RUN;
    VARIABLE NM 1;
    VARIABLE COORD 2000 1;
    DAINI 2 1 0 NM;
    COORD := DA(1) & 0;
    WRITE 6 CONS(COORD(1) + 1);
    WRITE 6 CONS(COORD(2) + 1);
ENDPROCEDURE;
RUN;
END;
