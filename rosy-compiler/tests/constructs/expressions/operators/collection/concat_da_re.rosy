BEGIN;
    DAINI 2 1 0 0;
    VARIABLE (DA 1) COORD;
    COORD := DA(1) & 0;
    WRITE 6 ST(CONS(COORD(1) + 1));
    WRITE 6 ST(CONS(COORD(2) + 1));
END;

