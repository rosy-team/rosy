BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) COORD;
    COORD(1) := COORD(1) & DA(1);
    COORD(1) := COORD(1) & DA(2);
    WRITE 6 ST(CONS(COORD(1)(1) + 1));
    WRITE 6 ST(CONS(COORD(1)(2) + 1));
END;

