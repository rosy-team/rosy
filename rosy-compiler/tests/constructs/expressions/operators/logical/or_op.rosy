BEGIN;
    VARIABLE (LO) R;
    R := TRUE OR TRUE;
    WRITE 6 R;
    R := TRUE OR FALSE;
    WRITE 6 R;
    R := FALSE OR TRUE;
    WRITE 6 R;
    R := FALSE OR FALSE;
    WRITE 6 R;
END;

======= expect
TRUE
