======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE R 1;
    R := LO(1) + LO(1);
    WRITE 6 R;
    R := LO(1) + LO(0);
    WRITE 6 R;
    R := LO(0) + LO(1);
    WRITE 6 R;
    R := LO(0) + LO(0);
    WRITE 6 R;
ENDPROCEDURE;
RUN;
END;
