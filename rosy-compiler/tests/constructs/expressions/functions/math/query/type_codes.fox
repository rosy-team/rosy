BEGIN;
PROCEDURE RUN;
    { TYPE of every data type. Expected output from Intel COSY 10.2:
      RE 1, ST 2, LO 3, CM 4, VE 5, DA 8, CD 9. }
    VARIABLE S 1; VARIABLE R 1; VARIABLE T 80; VARIABLE L 1; VARIABLE C 2;
    VARIABLE V 10; VARIABLE D 100; VARIABLE E 200;
    DAINI 2 2 0 S;
    R := 1.5; T := 'abc'; L := LO(1); C := CMPLX(1);
    V := 1&2; D := DA(1); E := CMPLX(1)*DA(1);
    WRITE 6 'RE' TYPE(R);
    WRITE 6 'ST' TYPE(T);
    WRITE 6 'LO' TYPE(L);
    WRITE 6 'CM' TYPE(C);
    WRITE 6 'VE' TYPE(V);
    WRITE 6 'DA' TYPE(D);
    WRITE 6 'CD' TYPE(E);
ENDPROCEDURE;
RUN;
END;

======= expect
RE
 1.000000000000000
ST
 2.000000000000000
LO
 3.000000000000000
CM
 4.000000000000000
VE
 5.000000000000000
DA
 8.000000000000000
CD
 9.000000000000000
