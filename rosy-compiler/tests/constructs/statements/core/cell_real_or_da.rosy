BEGIN;
PROCEDURE RUN;
    VARIABLE D 20 1;
    VARIABLE T 20;
    VARIABLE TI 20;
    VARIABLE S 1;
    VARIABLE NM 1;
    DAINI 3 1 0 NM;
    T := 0.25;
    S := 1;
    D(1) := S - T|1;
    IF S<0;
        D(1) := DA(1) + S;
    ENDIF;
    TI := T|1 + D(1);
    T := TI;
    WRITE 6 T|1;
ENDPROCEDURE;
RUN;
END;
