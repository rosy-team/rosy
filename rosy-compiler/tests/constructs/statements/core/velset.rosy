BEGIN;
    PROCEDURE SETSECOND V;
        VELSET V 2 99;
    ENDPROCEDURE;
    VARIABLE (VE) V;
    V := 1&2&3&4&5&6;
    SETSECOND V;
    WRITE 6 ST(V);
END;

