======= fox
BEGIN;
PROCEDURE RUN;
    PROCEDURE SETSECOND V;
        VELSET V 2 99;
    ENDPROCEDURE;
    VARIABLE V 100;
    V := 1&2&3&4&5&6;
    SETSECOND V;
    WRITE 6 V;
ENDPROCEDURE;
RUN;
END;
