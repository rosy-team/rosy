BEGIN;
PROCEDURE RUN;
    VARIABLE B 7;
    LTRUE B;
    LFALSE B;
    IF B;
        WRITE 6 'lfalse broken';
    ELSE;
        WRITE 6 'lfalse ok';
    ENDIF;
ENDPROCEDURE;
RUN;
END;
