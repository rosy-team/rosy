======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE X 1;
    X := 1;
    IF LO(1);
        VARIABLE X 1;
        X := 2;
        WRITE 6 X;
    ENDIF;
    WRITE 6 X;
ENDPROCEDURE;
RUN;
END;
