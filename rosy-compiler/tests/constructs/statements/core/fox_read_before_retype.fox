BEGIN;
PROCEDURE RUN;
    VARIABLE I 1;
    VARIABLE X 10;

    WRITE 6 'X: ' X;

    X := 1;
    LOOP I 2 6;
        X := X&I;
    ENDLOOP;

    WRITE 6 'X: ' X;
ENDPROCEDURE;
RUN;
END;

