BEGIN;
    VARIABLE X;
    VARIABLE J;
    J := 0.5;
    X := 10^(-2)*J;
    LOOP I 2 4;
        X := X & (10^(-2)*J);
    ENDLOOP;
    WRITE 6 ST(X);
END;

