======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE X 200;
    VARIABLE J 1;
    J := 0.5;
    X := 10^(-2)*J;
    LOOP I 2 4;
        X := X & 10^(-2)*J;
    ENDLOOP;
    WRITE 6 ST(X);
ENDPROCEDURE;
RUN;
END;
