BEGIN;
    DAINI 4 2 0 0;
    VARIABLE (DA 1) P;
    VARIABLE (RE 2) A;
    VARIABLE (RE 1) R;
    P(1) := 3 + SQR(DA(1))*DA(2);
    A(1) := 2;
    A(2) := 5;
    POLVAL 1 P 1 A 2 R 1;
    { 3 + 2^2 * 5 = 23 }
    IF ABS(R(1)-23) < 1e-10;
        WRITE 6 'polval horner ok';
    ENDIF;
END;

