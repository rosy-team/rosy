BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 2) P;
    VARIABLE (RE 100) A;
    VARIABLE (RE 100) R;
    P(1) := 1 + DA(1);
    P(2) := 1 + DA(2);
    A(1) := 2;
    A(2) := 3;
    POLVAL 1 P 2 A 2 R 2;
    IF ABS(R(1)-3) < 1e-10;
        IF ABS(R(2)-4) < 1e-10;
            WRITE 6 'polval ok';
        ENDIF;
    ENDIF;
END;

