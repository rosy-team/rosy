BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) X;
    X(1) := 100 + 0.001*DA(1) + DA(2);
    DANORS X 1;
    DAPRV X 1 2 2 6;
    WRITE 6 'danors ok';
END;

