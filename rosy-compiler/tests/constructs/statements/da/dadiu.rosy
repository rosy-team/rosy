BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) INPUT;
    VARIABLE (DA 1) OUTPUT;
    INPUT(1) := DA(1);
    DADIU 1 INPUT OUTPUT;
    WRITE 6 'dadiu ok';
END;

