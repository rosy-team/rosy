BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) INPUT;
    VARIABLE (DA 1) OUTPUT;
    VARIABLE (VE) SCALES;
    VARIABLE (VE) SHIFTS;
    INPUT(1) := DA(1);
    SCALES := 2.0 & 1.0;
    SHIFTS := 1.0 & 0.0;
    DATRN INPUT SCALES SHIFTS 1 1 OUTPUT;
    DAPRV OUTPUT 1 2 2 6;
END;

======= expect
   1.000000     000000
