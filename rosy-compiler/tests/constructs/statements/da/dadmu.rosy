BEGIN;
    DAINI 3 2 0 0;
    VARIABLE (DA 1) INPUT;
    VARIABLE (DA 1) OUTPUT;
    INPUT(1) := DA(1);
    DADMU 1 2 INPUT OUTPUT;
    WRITE 6 'dadmu ok';
END;

