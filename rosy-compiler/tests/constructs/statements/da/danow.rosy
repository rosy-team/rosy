======= fox
BEGIN;
PROCEDURE RUN;
    VARIABLE A 2000;
    VARIABLE R 1;
    DAINI 3 2 0 0;
    A := DA(1) + 2*DA(2);
    DANOW A 1.5 R;
    WRITE 6 'DANOW result:' R;
ENDPROCEDURE;
RUN;
END;
