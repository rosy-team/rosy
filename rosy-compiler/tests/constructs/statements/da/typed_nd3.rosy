BEGIN;

MODULE GITHUB "rosy-team/libcosy" "v1.1.4";

OV 3 3 0;
RPP 100;
UM;
{ libcosy v1.1.4 RP omits COSY's ND=3 energy promotion
  `E0 := CONS(E0)*(1+DD(6))` so XX(6)/MAP(6) start at 0.
  Apply the same two lines COSY RP uses; MAP(6) must be DD(6). }
IF ND = 3;
    E0 := CONS(E0)*(1+DD(6));
    MAP(6) := (E0-CONS(E0))/CONS(E0);
ENDIF;
WRITE 6 'MAP(6)=';
WRITE 6 MAP(6);

END;

======= expect
MAP(6)=
     I  COEFFICIENT            ORDER EXPONENTS
     1   1.000000000000000       1   0 0  0 0  0 1
     ---------------------------------------------
