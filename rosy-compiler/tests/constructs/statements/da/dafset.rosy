BEGIN;
    VARIABLE (DA 1) template;
    VARIABLE (DA 1) A;
    VARIABLE (DA 1) B;
    DAINI 3 2 0 0;
    template(1) := DA(1) + DA(2);
    A(1) := DA(1) + 2*DA(2) + 3*DA(1)*DA(2);
    DAFSET template;
    DAFILT A B;
    DAPRV B 1 2 2 6;
    WRITE 6 'dafset dafilt ok';
END;

