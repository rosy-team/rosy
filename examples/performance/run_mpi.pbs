#!/bin/bash
#PBS -N rosy_mpi
#PBS -l select=20:ncpus=1:mpiprocs=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o rosy_mpi.out

# ============================================================================
#  Rosy vs COSY — MPI Benchmarks (--release, 20 ranks)
# ============================================================================
#  All PLOOP benchmarks use NP=20 (matching MPI world size).
#  TIER_SCALE is passed as argv[1] / tier_scale.dat (old inner-loop counts).
# ============================================================================

cd $PBS_O_WORKDIR

module purge
module load openmpi/openmpi-5.0.7-gcc-14.2.0-cuda-12.8

COSY_BIN="$PBS_O_WORKDIR/../../cosy_mpi"
NP=20
MPI_DIR="$PBS_O_WORKDIR/mpi"
SCALE_OVERRIDE="${SCALE:-}"
BUILD_FLAGS="--release"

default_scale() {
    case "$1" in
        01_ploop_arithmetic)    echo 300000000 ;;
        02_ploop_da)            echo 30000 ;;
        03_ploop_matrix)        echo 1500 ;;
        04_ploop_optimization)  echo 60 ;;
        05_ploop_math)          echo 140000000 ;;
        06_ploop_scaling)       echo 200000000 ;;
        07_ploop_nested)        echo 6000000 ;;
        08_ploop_large_output)  echo 150000000 ;;
        09_ploop_vector)        echo 3000000 ;;
        *)                      echo 1 ;;
    esac
}

cleanup_artifacts() {
    rm -f "$MPI_DIR"/*.txt "$MPI_DIR"/*.dat "$MPI_DIR"/*.lis "$MPI_DIR"/bench_rosy* 2>/dev/null || true
}

echo ""
echo "================================================================"
echo "       Rosy vs COSY — MPI Benchmarks (--release, $NP ranks)"
echo "================================================================"
echo "  Date:  $(date)"
echo "  Nodes: $(cat $PBS_NODEFILE | wc -l)"
echo "  Rosy:  $(rosy --version 2>/dev/null || echo 'unknown')"
echo "  COSY:  $([[ -x $COSY_BIN ]] && echo 'found' || echo 'not found')"
echo ""

HAS_COSY=false
[[ -x "$COSY_BIN" ]] && HAS_COSY=true

if $HAS_COSY; then
    printf "%-30s %12s %11s %11s %10s\n" "Benchmark" "Scale" "Rosy (s)" "COSY (s)" "Speedup"
    printf "%-30s %12s %11s %11s %10s\n" "------------------------------" "------------" "-----------" "-----------" "----------"
else
    printf "%-30s %12s %11s\n" "Benchmark" "Scale" "Rosy (s)"
    printf "%-30s %12s %11s\n" "------------------------------" "------------" "-----------"
fi

TOTAL_ROSY=0; TOTAL_COSY=0; NUM=0

for fox_file in "$MPI_DIR"/*.fox; do
    [[ -f "$fox_file" ]] || continue
    name=$(basename "$fox_file" .fox)
    NUM=$((NUM + 1))
    if [[ -n "$SCALE_OVERRIDE" ]]; then
        scale="$SCALE_OVERRIDE"
    else
        scale=$(default_scale "$name")
    fi

    BUILD_DIR=$(mktemp -d /tmp/rosy_mpi_rel_XXXXXX)
    if ! rosy build "$fox_file" $BUILD_FLAGS -d "$BUILD_DIR" -o "$MPI_DIR/bench_rosy" 2>/dev/null; then
        rm -rf "$BUILD_DIR"
        sleep 5
        BUILD_DIR=$(mktemp -d /tmp/rosy_mpi_rel_XXXXXX)
        if ! rosy build "$fox_file" $BUILD_FLAGS -d "$BUILD_DIR" -o "$MPI_DIR/bench_rosy" 2>/dev/null; then
            rm -rf "$BUILD_DIR"
            printf "%-30s %12s %11s\n" "$name" "$scale" "BUILD FAIL"
            continue
        fi
    fi

    echo "$scale" > "$MPI_DIR/tier_scale.dat"
    mpirun -np $NP -hostfile $PBS_NODEFILE "$MPI_DIR/bench_rosy" "$scale" > "$MPI_DIR/rosy_${name}_output.txt" 2>&1
    rosy_cpusec=$(grep -oP 'CPUSEC:\s*\K[\d.]+' "$MPI_DIR/rosy_${name}_output.txt" | tail -1)
    if [[ -n "$rosy_cpusec" ]]; then
        TOTAL_ROSY=$(awk "BEGIN { printf \"%.6f\", $TOTAL_ROSY + $rosy_cpusec }")
    fi

    if $HAS_COSY; then
        rm -f "$MPI_DIR"/*.lis
        echo "$name" > "$MPI_DIR/foxyinp.dat"
        (cd "$MPI_DIR" && echo "$name" | mpirun -np $NP -hostfile $PBS_NODEFILE "$COSY_BIN") > "$MPI_DIR/cosy_${name}_output.txt" 2>&1

        if grep -qE "### ERROR|ERROR OCCURED" "$MPI_DIR/cosy_${name}_output.txt" 2>/dev/null; then
            printf "%-30s %12s %11s %11s %10s\n" "$name" "$scale" "${rosy_cpusec:-N/A}" "COSY ERR" "N/A"
        else
            cosy_cpusec=$(grep -A1 'CPUSEC:' "$MPI_DIR/cosy_${name}_output.txt" | grep -v 'CPUSEC:' | tail -1 | awk '{printf "%.6f", $1}')
            if [[ -n "$cosy_cpusec" && -n "$rosy_cpusec" ]]; then
                TOTAL_COSY=$(awk "BEGIN { printf \"%.6f\", $TOTAL_COSY + $cosy_cpusec }")
                speedup=$(awk "BEGIN { if ($rosy_cpusec > 0.0001) printf \"%.1f\", $cosy_cpusec / $rosy_cpusec; else print \"INF\" }")
                printf "%-30s %12s %11s %11s %9sx\n" "$name" "$scale" "$rosy_cpusec" "$cosy_cpusec" "$speedup"
            else
                printf "%-30s %12s %11s %11s %10s\n" "$name" "$scale" "${rosy_cpusec:-N/A}" "${cosy_cpusec:-N/A}" "N/A"
            fi
        fi
    else
        printf "%-30s %12s %11s\n" "$name" "$scale" "${rosy_cpusec:-N/A}"
    fi

    rm -f "$MPI_DIR/bench_rosy"
    rm -rf "$BUILD_DIR"
    cleanup_artifacts
done

echo ""
if $HAS_COSY; then
    printf "%-30s %12s %11s %11s %10s\n" "------------------------------" "------------" "-----------" "-----------" "----------"
    total_speedup=$(awk "BEGIN { if ($TOTAL_ROSY > 0.0001) printf \"%.1f\", $TOTAL_COSY / $TOTAL_ROSY; else print \"N/A\" }")
    printf "%-30s      %11.4f %11.4f %9sx\n" "TOTAL ($NUM benchmarks)" "$TOTAL_ROSY" "$TOTAL_COSY" "$total_speedup"
    echo ""
    echo "  Both Rosy and COSY run with $NP MPI ranks."
fi
echo ""
echo "================================================================"
echo "  Complete: $(date)"
echo "================================================================"
