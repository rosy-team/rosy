{ Benchmark: String operations }
{ Tests: string concatenation, SUBSTR, ST conversion }
{ TIER_SCALE: iterations (old T4 = 1000000) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE S 200 ;
VARIABLE T 200 ;
VARIABLE N 1 ;
VARIABLE LEN 1 ;
VARIABLE I 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

N := TIER_SCALE ;
S := 's' ;
T := 't' ;

WRITE 6 'String Operations Benchmark: ' N ' iterations' ;

CPUSEC T1 ;

LOOP I 1 N ;
    S := ST(I * 3.14159) ;
    T := 'Value=' & S & ' Index=' & ST(I) ;
    LEN := LENGTH(T) ;
ENDLOOP ;

CPUSEC T2 ;

DT := T2 - T1 ;
WRITE 6 'Last string: ' T ;
WRITE 6 'Last length: ' LEN ;
WRITE 6 'Result: ' LEN ;
WRITE 6 'CPUSEC: ' DT ;

END ;
