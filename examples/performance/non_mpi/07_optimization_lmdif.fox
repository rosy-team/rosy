{ Benchmark: LMDIF on 2-var Rosenbrock as least squares }
{   OBJ1 = 10*(B - A^2), OBJ2 = 1 - A. Unique min (1, 1). }
{ Classic Moré start (-1.2, 1.0): banana valley, both COSY and Rosy converge. }
{ TIER_SCALE: 100x repetitions (old T4 = 5000 solves => 500000) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE A 1 ;
VARIABLE B 1 ;
VARIABLE OBJ1 1 ;
VARIABLE OBJ2 1 ;
VARIABLE EPS 1 ;
VARIABLE K 1 ;
VARIABLE NS 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

NS := TIER_SCALE / 100 ;
IF (NS < 1) ;
    NS := 1 ;
ENDIF ;

WRITE 6 'Optimization LMDIF Benchmark: 2-var Rosenbrock, ' NS ' solves' ;

CPUSEC T1 ;

LOOP K 1 NS ;
    A := -1.2 ;
    B := 1.0 ;
    EPS := 0.0000000001 ;

    FIT A B ;
        OBJ1 := 10 * (B - A * A) ;
        OBJ2 := 1 - A ;
    ENDFIT EPS 5000 4 OBJ1 OBJ2 ;
ENDLOOP ;

CPUSEC T2 ;

DT := T2 - T1 ;
WRITE 6 'Final: A=' A ' B=' B ;
WRITE 6 'Final OBJ1=' OBJ1 ' OBJ2=' OBJ2 ;
WRITE 6 'Result: ' A ;
WRITE 6 'CPUSEC: ' DT ;

END ;
