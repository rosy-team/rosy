{ Benchmark: LMDIF (Levenberg-Marquardt) optimizer on 4-variable Rosenbrock }
{ Tests: gradient-based optimization performance }
{ TIER_SCALE: 100x starting points (old T4 = 5000 starts => 500000) }
{ Each start is a full LMDIF solve; divide so --scale 10000 stays ~100ms. }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE A 1 ;
VARIABLE B 1 ;
VARIABLE C 1 ;
VARIABLE D 1 ;
VARIABLE OBJ1 1 ;
VARIABLE OBJ2 1 ;
VARIABLE OBJ3 1 ;
VARIABLE EPS 1 ;
VARIABLE K 1 ;
VARIABLE NS 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

NS := TIER_SCALE / 100 ;
IF (NS < 1) ;
    NS := 1 ;
ENDIF ;

WRITE 6 'Optimization LMDIF Benchmark: 4-var Rosenbrock, ' NS ' starting points' ;

CPUSEC T1 ;

LOOP K 1 NS ;
    A := -2.0 + K * 0.1 ;
    B := -2.0 + K * 0.15 ;
    C := -2.0 + K * 0.2 ;
    D := -2.0 + K * 0.05 ;
    EPS := 0.0000000001 ;

    FIT A B C D ;
        OBJ1 := 100 * (B - A * A) ^ 2 + (1 - A) ^ 2 ;
        OBJ2 := 100 * (C - B * B) ^ 2 + (1 - B) ^ 2 ;
        OBJ3 := 100 * (D - C * C) ^ 2 + (1 - C) ^ 2 ;
    ENDFIT EPS 5000 4 OBJ1 OBJ2 OBJ3 ;
ENDLOOP ;

CPUSEC T2 ;

DT := T2 - T1 ;
WRITE 6 'Final: A=' A ' B=' B ' C=' C ' D=' D ;
WRITE 6 'Final OBJ1=' OBJ1 ' OBJ2=' OBJ2 ' OBJ3=' OBJ3 ;
WRITE 6 'CPUSEC: ' DT ;

END ;
