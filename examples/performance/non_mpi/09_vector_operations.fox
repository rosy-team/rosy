{ Benchmark: Vector construction and operations }
{ Tests: vector concatenation, VMAX, VMIN, ABS }
{ TIER_SCALE: iterations (old T4 = 1000000) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE V 10 ;
VARIABLE N 1 ;
VARIABLE ACC 1 ;
VARIABLE I 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

N := TIER_SCALE ;
ACC := 0.0 ;

WRITE 6 'Vector Operations Benchmark: ' N ' iterations of build+VMAX+VMIN+ABS' ;

CPUSEC T1 ;

LOOP I 1 N ;
    V := SIN(I * 0.01) & COS(I * 0.01) & SIN(I * 0.02) & COS(I * 0.02)
       & SIN(I * 0.03) & COS(I * 0.03) & SIN(I * 0.04) & COS(I * 0.04)
       & SIN(I * 0.05) & COS(I * 0.05) ;

    ACC := ACC + VMAX(V) - VMIN(V) + ABS(V) ;
ENDLOOP ;

CPUSEC T2 ;

DT := T2 - T1 ;
WRITE 6 'Accumulated result: ' ACC ;
WRITE 6 'Result: ' ACC ;
WRITE 6 'CPUSEC: ' DT ;

END ;
