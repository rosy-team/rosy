{ Benchmark: Simplex (Nelder-Mead) optimizer on 4-variable Rosenbrock function }
{ Tests: optimization algorithm performance, function evaluation overhead }
{ TIER_SCALE: starting points (old T4 = 5000) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE A 1 ;
VARIABLE B 1 ;
VARIABLE C 1 ;
VARIABLE D 1 ;
VARIABLE OBJ 1 ;
VARIABLE EPS 1 ;
VARIABLE K 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

WRITE 6 'Optimization Simplex Benchmark: 4-var Rosenbrock, ' TIER_SCALE ' starting points' ;

CPUSEC T1 ;

LOOP K 1 TIER_SCALE ;
    A := -2.0 + K * 0.1 ;
    B := -2.0 + K * 0.15 ;
    C := -2.0 + K * 0.2 ;
    D := -2.0 + K * 0.05 ;
    EPS := 0.0000000001 ;

    FIT A B C D ;
        OBJ := 100 * (B - A * A) ^ 2 + (1 - A) ^ 2
             + 100 * (C - B * B) ^ 2 + (1 - B) ^ 2
             + 100 * (D - C * C) ^ 2 + (1 - C) ^ 2 ;
    ENDFIT EPS 5000 1 OBJ ;
ENDLOOP ;

CPUSEC T2 ;

DT := T2 - T1 ;
WRITE 6 'Final: A=' A ' B=' B ' C=' C ' D=' D ;
WRITE 6 'Final OBJ=' OBJ ;
WRITE 6 'CPUSEC: ' DT ;

END ;
