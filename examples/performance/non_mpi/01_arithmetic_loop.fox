{ Benchmark: Tight arithmetic loop of mixed FP operations }
{ Tests: compiled vs interpreted loop overhead, FP throughput }
{ TIER_SCALE: loop iterations (old T4 = 500000000) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE X 1 ;
VARIABLE Y 1 ;
VARIABLE Z 1 ;
VARIABLE N 1 ;
VARIABLE I 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

N := TIER_SCALE ;
X := 1.0 ;
Y := 2.0 ;
Z := 0.0 ;

WRITE 6 'Arithmetic Loop Benchmark: ' N ' iterations' ;

CPUSEC T1 ;

LOOP I 1 N ;
    Z := Z + X * Y - X / (Y + 1.0) + SQRT(X) ;
    X := X + 0.000000001 ;
ENDLOOP ;

CPUSEC T2 ;

DT := T2 - T1 ;
WRITE 6 'Result Z = ' Z ;
WRITE 6 'Result: ' Z ;
WRITE 6 'CPUSEC: ' DT ;

END ;
