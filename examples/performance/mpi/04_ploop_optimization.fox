{ Benchmark: PLOOP distributing optimization runs }
{ Tests: parallel optimization from different starting points }
{ PLOOP over 20 ranks. TIER_SCALE: Simplex repeats per rank (old = 60) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE RESULTS 1 20 ;
VARIABLE A 1 ;
VARIABLE B 1 ;
VARIABLE OBJ 1 ;
VARIABLE EPS 1 ;
VARIABLE I 1 ;
VARIABLE REP 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

WRITE 6 'PLOOP Optimization Benchmark: 20 parallel Simplex runs x ' TIER_SCALE ;

CPUSEC T1 ;

PLOOP I 1 20 ;
    LOOP REP 1 TIER_SCALE ;
        A := -5.0 + I * 0.5 + REP * 0.01 ;
        B := -5.0 + I * 0.3 + REP * 0.01 ;
        EPS := 0.0000000001 ;

        FIT A B ;
            OBJ := 100 * (B - A * A) ^ 2 + (1 - A) ^ 2 ;
        ENDFIT EPS 10000 1 OBJ ;
    ENDLOOP ;

    RESULTS(I) := OBJ ;
ENDPLOOP RESULTS ;

CPUSEC T2 ;

WRITE 6 'Results(1) = ' RESULTS(1) ;
WRITE 6 'Results(10) = ' RESULTS(10) ;
WRITE 6 'Results(20) = ' RESULTS(20) ;
DT := T2 - T1 ;
WRITE 6 'CPUSEC: ' DT ;

END ;
