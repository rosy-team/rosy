{ Benchmark: PLOOP strong scaling test }
{ Tests: how well parallelism scales with rank count }
{ NP must match MPI world size (run with -np 20) }
{ TIER_SCALE: inner loop iterations (old = 200000000) }
BEGIN ;

VARIABLE T1 1 ;
VARIABLE T2 1 ;
VARIABLE RESULTS 1 20 ;
VARIABLE ACC 1 ;
VARIABLE X 1 ;
VARIABLE Y 1 ;
VARIABLE I 1 ;
VARIABLE J 1 ;
VARIABLE DT 1 ;
VARIABLE TIER_SCALE 1 ;
VARIABLE SCALE_ST 200 ;

SCALE_ST := '1' ;
ARGGET 1 SCALE_ST ;
IF (LENGTH(SCALE_ST) = 0) ;
    OPENF 77 'tier_scale.dat' 'UNKNOWN' ;
    READS 77 SCALE_ST ;
    CLOSEF 77 ;
ENDIF ;
IF (LENGTH(SCALE_ST) = 0) ;
    SCALE_ST := '1' ;
ENDIF ;
STCRE SCALE_ST TIER_SCALE ;
IF (TIER_SCALE < 1) ;
    TIER_SCALE := 1 ;
ENDIF ;

WRITE 6 'PLOOP Scaling Benchmark: 20 iterations x ' TIER_SCALE ' ops each' ;
WRITE 6 'Run with -np 20' ;

CPUSEC T1 ;

PLOOP I 1 20 ;
    ACC := 0.0 ;
    X := I * 0.001 ;
    LOOP J 1 TIER_SCALE ;
        Y := X + J * 0.0000001 ;
        ACC := ACC + SIN(Y) + COS(Y) + SQRT(ABS(Y)) ;
    ENDLOOP ;
    RESULTS(I) := ACC ;
ENDPLOOP RESULTS ;

CPUSEC T2 ;

WRITE 6 'Results(1) = ' RESULTS(1) ;
WRITE 6 'Results(10) = ' RESULTS(10) ;
WRITE 6 'Results(20) = ' RESULTS(20) ;
DT := T2 - T1 ;
WRITE 6 'CPUSEC: ' DT ;

END ;
