{ Issue 2: DA & DA concatenation. Builds a 1D-of-DA via repeated concat
  with no LHS index (flat 1D). Indexed `COORD(1) := COORD(1) & Y` now
  nests one extra dim on COORD (see concat_da_indexed.rosy). }

BEGIN;

PROCEDURE RUN;
  VARIABLE (DA) X;
  VARIABLE (DA) Y;
  VARIABLE (DA 1) COORD;
  VARIABLE (RE) I;
  VARIABLE (RE) NP;

  X := DA(1);
  Y := DA(2);
  NP := 3;
  COORD := X & Y;
  LOOP I 3 NP;
    COORD := COORD & Y;
  ENDLOOP;
  WRITE 6 'COORD built — first slot:';
  WRITE 6 COORD[1];
ENDPROCEDURE;

RUN;
END;
